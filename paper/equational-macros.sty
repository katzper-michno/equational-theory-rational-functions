% reference to the appendix: \cref in the full version, ``the full version'' otherwise
\newcommand{\appref}[1]{\iffullversion\cref{#1}\else the full version\fi}
% the place where appendix material can be found, for use in prose
\newcommand{\appendixplace}{\iffullversion the appendix\else the full version\fi}

