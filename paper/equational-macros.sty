  \left.\def\arraystretch{1.2}\begin{array}{@{}r@{\enspace}}%
}{%
  \end{array}\right\rbrace%
}

%  --------------------------
% environements for atomic terms and axioms

\newcounter{ouraxiomcounter}
\newenvironment{axiomgroup}{
\medskip
\refstepcounter{ouraxiomcounter}
\smallskip\noindent{\textbf{{Axiom \arabic{ouraxiomcounter}. }}}}{
$\Box$ \smallskip
}

\newtagform{axiomtag}{(Axiom~}{)}
\newenvironment{axiom}{%
\begingroup
\crefalias{equation}{axiom}%
\usetagform{axiomtag}%
\align
}{%
\endalign
\endgroup
}

\newcounter{atomictermcounter}
\renewcommand{\theatomictermcounter}{\arabic{atomictermcounter}}
\newenvironment{atomicterm}{%
\refstepcounter{atomictermcounter}%
\begin{equation*}\tag{\theatomictermcounter}%
}{%
\end{equation*}%
\ignorespacesafterend
}


