% only the stmaryrd symbols we need: \fatsemi (composition) and \Yright (for \xrightarrowtail)
\usepackage[only,fatsemi,Yright]{stmaryrd}
% extensible two-headed arrow (formerly from extpfeil, which is not on ACM's list of accepted packages)
\providecommand*\xtwoheadrightarrow[2][]{\ext@arrow 0579\twoheadrightarrowfill@{#1}{#2}}
\newcommand*\twoheadrightarrowfill@{\arrowfill@\relbar\relbar\twoheadrightarrow}

% sequential composition; TeX puts no space around binary operators in script styles
% (e.g. arrow labels in diagrams), so there we add thin spaces explicitly
\newcommand{\comp}{\mathchoice{\fatsemi}{\fatsemi}{\mathbin{\,\fatsemi\,}}{\mathbin{\,\fatsemi\,}}}

% blackboard bold 1 for the unit type; \varmathbb comes from newtxmath, which acmart loads
% under pdflatex (a Type 1 font, unlike the bitmap fonts of the bbm package); under lualatex,
% which the Lax archive uses for the web view of the paper, acmart loads unicode-math instead
\ifdefined\varmathbb
  \newcommand{\onetype}{\varmathbb{1}}
\else
  % (braced, so that \vec\onetype still gets a single argument)
  \newcommand{\onetype}{{\mathbb{1}}}
\fi
\newcommand{\twotype}{\left( \onetype + \onetype \right)}
