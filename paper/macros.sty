% Aliases for labels
\makeatletter
% when the aux file is read, label #1 becomes a copy of label #2 (including its hyperref anchor and cleveref data),
% so that \ref{#1} prints and links exactly like \ref{#2}
% (the copy instruction is written at the very end of the aux file, after all labels)
\newcommand{\aliaslabel}[2]{%
  \@bsphack
  \AddToHook{enddocument/afterlastpage}{\immediate\write\@auxout{\string\@copylabel{#1}{#2}}}%
  \@esphack
}
\newcommand{\@copylabel}[2]{%
  \@ifundefined{r@#2}{}{\global\expandafter\let\csname r@#1\expandafter\endcsname\csname r@#2\endcsname}%
  \@ifundefined{r@#2@cref}{}{\global\expandafter\let\csname r@#1@cref\expandafter\endcsname\csname r@#2@cref\endcsname}%
}
\makeatother
